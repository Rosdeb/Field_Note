# ==============================================================================
# Field Notes - Comprehensive .gitignore for Public Repository
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Environment Variables
# ------------------------------------------------------------------------------
# NEVER commit environment files containing private endpoints or secrets
.env*
!.env.example

# Private keys, certificates, and credentials
*.key
*.pem
*.crt
*.cer
*.der
*.p12
*.pfx
*.p8
AuthKey_*.p8

# Android Signing & Local Properties
key.properties
local.properties
**/android/local.properties
**/android/key.properties
*.keystore
*.jks

# Firebase & Google Service Credentials
google-services.json
**/android/app/google-services.json
GoogleService-Info.plist
**/ios/Runner/GoogleService-Info.plist
**/macos/Runner/GoogleService-Info.plist
client_secret*.json
credentials.json
firebase_options.dart

# Sentry & Crashlytics Tokens
sentry.properties

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Flutter & Dart Artifacts
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Documentation & Symbols
**/doc/api/
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Android Artifacts
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/app/build/
**/android/build/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.apk
*.aab
.cxx/
GeneratedPluginRegistrant.java

# ------------------------------------------------------------------------------
# iOS & macOS Artifacts
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner/GeneratedPluginRegistrant.*
**/DerivedData/
**/xcuserdata/
**/project.xcworkspace/xcuserdata/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Miscellaneous
*.log
*.class
*.pyc
*.swp
*~
.history
.svn/
.swiftpm/
migrate_working_dir/
