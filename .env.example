# ==============================================================================
# FIELD NOTES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template is safe for public repositories.
#
# QUICK START:
#   1. Copy this file to create your local .env:
#      cp .env.example .env
#   2. Adjust BASE_URL if you are testing on an Android emulator or device.
#
# IMPORTANT SECURITY RULES:
#   - NEVER commit your local '.env' file or production credentials to Git.
#   - Keep '.env' listed in .gitignore.
#   - For CI/CD or production releases, inject secrets via GitHub Actions
#     Secrets or Flutter's `--dart-define` build arguments.
# ==============================================================================

# ------------------------------------------------------------------------------
# API BASE URL
# ------------------------------------------------------------------------------
# Choose one of the following based on your target platform:
#
# - iOS Simulator / macOS Desktop:  http://127.0.0.1:8080
# - Android Emulator (Loopback):    http://10.0.2.2:8080
# - Web Browser (Localhost):        http://localhost:8080
# - Physical Mobile Device (LAN):   http://192.168.1.X:8080 (replace with host IP)
# - Remote Staging Environment:     https://staging-api.fieldnotes.example.com
# - Remote Production Environment:  https://api.fieldnotes.example.com
BASE_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development | staging | production
APP_ENV=development

# ------------------------------------------------------------------------------
# OPTIONAL CLIENT DIAGNOSTICS & SYNC SETTINGS
# ------------------------------------------------------------------------------
# Enable or disable detailed debug logs in the terminal
ENABLE_DEV_LOGS=true

# Sync debounce delay in milliseconds (default: 500)
SYNC_DEBOUNCE_MS=500
