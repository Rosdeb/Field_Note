              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "data-controller"
        ],
        "operationId": "put",
        "parameters": [
          {
            "name": "resource",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
